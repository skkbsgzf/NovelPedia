{
  "_说明": "模型预设注册表（多类型模型匹配）。cli.py --backend 从这里枚举预设名；--role 可对指定角色覆盖模型。key 一律从环境变量 LLM_API_KEY 或 --key 传入，不写进本文件。",
  "_角色说明": "extract=场景抽取(高频短输出) | collect=四维收集(高频) | mine=暗线/设定/简历挖掘(中频长输出) | review=编辑评述/创作解析(低频高质量) | summary=章纲总结 | embed=向量化(仅 ollama)。routing 给出推荐默认，可用 --role 覆盖。",
  "_后端说明": "backend=ollama(本地) | openai(OpenAI 兼容) | anthropic(Claude 原生 API) | google(Gemini 原生 API)。模型 ID 与上下文长度以厂商最新文档为准，本表为保守常见值，可自行修改。",
  "doubt_index": 0.5,
  "default_backend": "dots3-note",
  "presets": {
    "dots3-note": {
      "name": "小红书 dots.ai（默认·效果最强）",
      "backend": "openai",
      "base_url": "https://note3-prev-api.askdiandian.com",
      "model": "dots3-note-prev",
      "auth_scheme": "apikey",
      "ctx": 512000,
      "json_mode": true,
      "thinking": false,
      "concurrency": 1,
      "cost": "paid",
      "roles": ["extract", "collect", "mine", "review", "summary"],
      "notes": "必须配 key；深度思考需关闭(enable_thinking=false)，否则只返回 reasoning_content 白烧 token"
    },
