      "auth_scheme": "bearer",
      "ctx": 200000,
      "json_mode": true,
      "thinking": false,
      "concurrency": 1,
      "cost": "free",
      "roles": ["extract", "collect", "mine", "review", "summary"],
      "notes": "免费；上下文200K/输出128K；限1并发；默认开深度思考(本库默认关)"
