  "routing": {
    "_说明": "角色 → 预设名 的推荐默认。--backend 选主模型，--role role=preset 覆盖单个角色（可多次）。",
    "default": "dots3-note",
    "extract": "dots3-note",
    "collect": "dots3-note",
    "mine": "dots3-note",
    "review": "dots3-note",
    "summary": "dots3-note",
    "embed": "qwen3-8b"
  }
